{
  "name": "dot-kanban",
  "version": "0.5.0",
  "description": "Obsidian plugin: kanban board of the vault's tasks, configured by dot-kanban code blocks.",
  "license": "MIT",
  "private": true,
  "author": "Clément OLIVIER <clement.olivier@deepika.ai>",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run test/unit",
    "test:desktop": "node scripts/test-obsidian.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "package": "npm run build && python3 scripts/package.py"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
